# Copy to .env.local. Never expose the service-role key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Demo is explicit and isolated in this browser; use false for production.
NEXT_PUBLIC_DEMO_MODE=true
CRON_SECRET=
AUTHKEY_API_KEY=
# Configure template IDs and positional fields in Settings before dispatch.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=
VOICE_WEBHOOK_SECRET=
INTAKE_SECRET=
INTEGRATION_ORGANIZATION_ID=
INTEGRATION_ACTOR_ID=
BOLNA_API_KEY=
BOLNA_AGENT_ID=
